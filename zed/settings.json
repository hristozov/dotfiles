{
  "disable_ai": true,
  "git": {
    "auto_fetch": {
      "interval_secs": 60,
      "enabled": true
    }
  },
  "use_display_p3": false,
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": true
  },
  "ui_font_size": 15,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "preferred_line_length": 100,
  "wrap_guides": [100]
}
