# Standalone zsh config. ~/.zshrc is a symlink to this file, so resolve the
# real directory to find the rest of the config.
ZSH_CONFIG_DIR=${${(%):-%x}:A:h}

for file in options environment path key-mappings aliases git-aliases prompt tools; do
  source "$ZSH_CONFIG_DIR/$file.zsh"
done
unset file

source $HOME/.profile
